// Schema source of truth — see docs/adr/ADR-001-database-access.md.
//
// Prisma owns the `public` schema only. Supabase owns `auth`, `storage`, and
// `realtime`; Prisma must never see them, or `migrate` will propose dropping them.
//
// RLS policies, functions, and triggers cannot be expressed here. They live as raw
// SQL inside the migration files, and every migration that adds a table needing a
// policy adds the policy in the same migration.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

/// Platform-wide role, distinct from a per-workspace role. Used only to gate the
/// admin console.
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
  @@schema("public")
}

/// Application profile for a Supabase Auth user.
///
/// `id` is the same uuid as `auth.users.id`. The foreign key and the trigger that
/// creates this row on sign-up live in SQL, because Prisma cannot reference another
/// schema without the multiSchema preview and must not manage Supabase's tables.
///
/// There is deliberately no password column: Supabase Auth owns credentials.
model User {
  id        String   @id @db.Uuid
  username  String   @unique
  email     String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  memberships  WorkspaceMember[]
  subscription UserSubscription?
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")

  @@index([roleId])
  @@map("users")
  @@schema("public")
}

/// Ownership boundary for every user-owned resource.
model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  members  WorkspaceMember[]
  projects Project[]

  @@index([ownerId])
  @@map("workspaces")
  @@schema("public")
}

/// Explicit membership. Authorization reads this, never a role claim on a token.
model WorkspaceMember {
  id        String   @id @default(uuid()) @db.Uuid
  role      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
  @@schema("public")
}

/// A user project inside a workspace. Ownership is the workspace's, so access is
/// resolved by membership rather than by any field on this row.
model Project {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String
  description String   @default("")
  board       String   @default("")
  framework   String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  files      ProjectFile[]
  components ProjectComponent[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("projects")
  @@schema("public")
}

/// One row per file. The project source tree is never a single JSON document, so a
/// save touches only the file that changed.
model ProjectFile {
  id          String   @id @default(uuid()) @db.Uuid
  path        String
  content     String
  contentHash String   @map("content_hash")
  sizeBytes   Int      @map("size_bytes")
  /// Optimistic concurrency: a write states the version it read.
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
  @@map("project_files")
  @@schema("public")
}

/// A subscription tier. Limits live in PlanLimit rows so adjusting one is a data
/// change rather than a deploy.
model Plan {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  rank      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  limits        PlanLimit[]
  subscriptions UserSubscription[]

  @@map("plans")
  @@schema("public")
}

/// One ceiling for one plan. A value of -1 means unlimited.
model PlanLimit {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  value     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  planId String @map("plan_id") @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@map("plan_limits")
  @@schema("public")
}

/// Which plan a user is on. Exactly one row per user, assigned at sign-up.
model UserSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String @map("plan_id") @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("user_subscriptions")
  @@schema("public")
}

/// One component placed in a project.
///
/// The catalog definition (what an ESP32 is) lives in code and is shared by every
/// project; this row is only where a particular one sits in a particular project.
model ProjectComponent {
  id           String   @id @default(uuid()) @db.Uuid
  /// Catalog key, e.g. "esp32-devkit-v1". Not a relation: the catalog is code.
  definitionId String   @map("definition_id")
  label        String   @default("")
  x            Float    @default(0)
  y            Float    @default(0)
  rotation     Int      @default(0)
  /// Property overrides only; defaults come from the definition.
  state        Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_components")
  @@schema("public")
}
