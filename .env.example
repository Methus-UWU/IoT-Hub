DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iot_hub
DATABASE_REPLICA_URL=
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
# Comma-separated allowlist. Production rejects all browser origins when unset.
CORS_ORIGINS=http://localhost:4200

# Local HTTP development only. Production always sends Secure refresh cookies.
ALLOW_INSECURE_COOKIES=true
PORT=3000

# Web IDE workspace storage. Every workspace route requires authentication.
WORKSPACE_ROOT=.workspace-data

# Development seed accounts. Passwords are generated when unset outside
# production; production refuses to seed without explicit values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# AI providers — configure one or more. Keys stay on the backend only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Free Meta Llama and NVIDIA Nemotron models are served through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
META_MODEL=meta-llama/llama-3.3-70b-instruct:free
GEMMA_MODEL=google/gemma-4-31b-it:free
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
