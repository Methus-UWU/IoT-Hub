# ---- Database ----
# The database URL is used by the backend to connect to the PostgreSQL database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iot_hub

# ---- App ----
# Allowed browser origins, comma-separated. FRONTEND_URL is still read as a
# single-origin fallback when this is unset.
CORS_ORIGINS=http://localhost:4200
# Express trust proxy. Leave empty when clients reach the API directly; behind
# nginx use the proxy networks, e.g. "loopback, uniquelocal".
TRUST_PROXY=

# ---- Workspace ----
# Optional. Defaults to .workspace-data under the working directory.
# WORKSPACE_ROOT=.workspace-data

# ---- Firmware builds ----
# Shared with the build dispatcher (build-worker/), which claims jobs with it.
# At least 32 characters, e.g. `openssl rand -hex 32`. Unset keeps builds off.
# The API never compiles: builds run in the isolated builder container.
# BUILD_WORKER_TOKEN=

# ---- Supabase ----
# Project URL and keys from Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://<project-ref>.supabase.co
# Backend only. This key bypasses RLS and must NOT be used in Angular.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# ---- AI provider (backend only) ----
# Project generation and the admin assistant go through OpenRouter. The IoT
# advisor uses Gemini when GEMINI_API_KEY is set and falls back to OpenRouter.
OPENROUTER_API_KEY=your_openrouter_key_here

# The model list is fetched from OpenRouter at runtime and ranked per task
# profile, so no model id is pinned in code. Everything below is optional.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# How long a fetched catalog is reused before refreshing.
# AI_CATALOG_TTL_MS=3600000
# Paid models stay out of the ranking unless this is exactly "true".
# AI_ALLOW_PAID_MODELS=false
# The project assistant's models, comma-separated, tried in order; the ranked models stay behind them as
# fallbacks. A paid model here is used even with AI_ALLOW_PAID_MODELS off: the pin
# is consent for that one model, while users and fallbacks stay on free models.
# AI_PROJECT_MODEL=deepseek/deepseek-v4-pro-0813,openai/gpt-5-mini
# How OpenRouter orders the hosts serving a model: latency (default), price, or
# throughput. "price" picks a discounted host first.
# AI_PROVIDER_SORT=latency
# Output ceiling per reply, further clamped by the chosen model's own limit.
# AI_MAX_OUTPUT_TOKENS=1600
# How many models per vendor the picker endpoint returns.
# AI_MODELS_PER_VENDOR=8
# Used only when the live catalog is unreachable and the cache is still cold.
# AI_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Gemini for the IoT advisor (backend only, optional) ----
# Unset means the advisor answers through OpenRouter alone. On the free tier
# Google may use prompts and answers to improve its products.
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-flash-lite-latest
# Thinking shares this budget on Gemini 3 models.
# GEMINI_MAX_OUTPUT_TOKENS=8192
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
